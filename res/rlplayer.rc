// rlplayer.rc — 程序图标与版本信息
#pragma code_page(65001)
#include <windows.h>

IDI_APPICON ICON "rlplayer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,15,0
 PRODUCTVERSION 1,3,15,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "RLPlayer"
            VALUE "FileDescription", "RLPlayer 高保真音乐播放器"
            VALUE "FileVersion", "1.3.15.0"
            VALUE "InternalName", "RLPlayer"
            VALUE "LegalCopyright", "RLPlayer"
            VALUE "OriginalFilename", "RLPlayer.exe"
            VALUE "ProductName", "RLPlayer"
            VALUE "ProductVersion", "1.3.15.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
